<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- SUBSTITUTION GROUP: partner sustituye a main_partner -->
    <xs:element name="main_partner" type="xs:string" />
    <xs:element name="partner" substitutionGroup="main_partner" type="xs:string" />

    <!-- GROUP: duration (start_date + end_date) -->
    <xs:group name="duration">
        <xs:sequence>
            <xs:element name="start_date" type="xs:date" />
            <xs:element name="end_date" type="xs:date" />
        </xs:sequence>
    </xs:group>

    <!-- SIMPLE TYPE: role_type → solo "intern" o "lead" -->
    <xs:simpleType name="roleType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="intern" />
            <xs:enumeration value="lead" />
        </xs:restriction>
    </xs:simpleType>

    <!-- SIMPLE TYPE: manager_code → patrón XXX-999 -->
    <xs:simpleType name="managerCodeType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-zA-ZñÑ]{1,3}-[0-9]{3}" />
        </xs:restriction>
    </xs:simpleType>

    <!-- SIMPLE TYPE: pay → decimal positivo menor de 5000 -->
    <xs:simpleType name="payType">
        <xs:restriction base="xs:decimal">
            <xs:minExclusive value="0" />
            <xs:maxExclusive value="5000" />
        </xs:restriction>
    </xs:simpleType>

    <!-- ELEMENTO RAÍZ: initiative -->
    <xs:element name="initiative">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="organization" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <!-- 2 a 5 staff por organization -->
                            <xs:element name="staff" minOccurs="2" maxOccurs="5">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="staff_name" type="xs:string" />
                                        <xs:element name="role" type="roleType" />
                                        <xs:element name="pay" type="payType" />
                                        <!-- grupo duration -->
                                        <xs:group ref="duration" />
                                        <!-- socio participante (con grupo de sustitución) -->
                                        <xs:element ref="main_partner" />
                                        <xs:element name="manager_code" type="managerCodeType" />
                                    </xs:sequence>
                                    <xs:attribute name="staff_id" type="xs:string" use="required" />
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="organization_name" type="xs:string" use="required" />
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="initiative_name" type="xs:string" use="required" />
        </xs:complexType>
    </xs:element>

</xs:schema>