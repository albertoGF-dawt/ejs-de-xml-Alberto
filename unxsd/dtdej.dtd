<!ELEMENT library (book+)>
<!ATTLIST library xmlns:xsi CDATA #REQUIRED>
<!ATTLIST library xsi:noNamespaceSchemaLocation CDATA #REQUIRED>

<!ELEMENT book (title, price, publisher?, editorial?)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT price (#PCDATA)>

<!ELEMENT publisher (name, country)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT country (#PCDATA)>

<!ELEMENT editorial (name, country)>

<!ATTLIST book isbn CDATA #REQUIRED>
<!ATTLIST book category CDATA #IMPLIED>